# Dependencies
node_modules/
.npm/

# Expo and generated native projects
.expo/
.expo-shared/
ios/
android/

# Build and test output
dist/
build/
coverage/
/tmp/
*.tsbuildinfo

# Local configuration
.env
.env.*
!.env.example
!**/.env.example
.secret.local
**/.secret.local

# Never commit long-lived Google service-account credentials.
*firebase-adminsdk*.json
*.service-account.json
# Play Console upload key for `eas submit` and Firebase native app configs (supplied through EAS).
play-service-account.json
google-services.json
GoogleService-Info.plist
# Apple API/signing credentials belong in local/EAS credential storage.
*.p8
*.p12
*.mobileprovision
credentials.json

# Firebase
.firebase/
# Prepared timetable indexes (generated by `npm run build:gtfs` in firebase/functions)
firebase/functions/static_data/*/derived/
firebase-debug.log
firestore-debug.log
firebase/functions/lib/

# Logs
*.log
npm-debug.log*

# Editors and operating systems
.DS_Store
.idea/
.vscode/
*.swp

# Walking graph tiles: build with `npm run build:walking` in firebase/functions before deploying.
firebase/functions/static_data/walking/

# Base map tiles and fonts: build with `npm run map:build` and `npm run map:fonts` (scripts/build-map.mjs).
maptiles/
maptiles.zip

# EAS CLI uses this repository-root file instead of every .gitignore.
# Keep the complete .gitignore block above synchronized when its rules change.

# Private local release material, including files without a key extension.
.credentials/

# Local audit artifacts, agent state, and scratch work are not app build inputs.
docs/
.agents/
.claude/
.codex/
.scratch/
scratch/

# Native builds fetch map resources at runtime and do not package backend GTFS data.
firebase/functions/static_data/

# Known local cloud-conflict copy; keep the canonical rideSnapshot.ts.
mobile/src/data/rideSnapshot 2.ts
